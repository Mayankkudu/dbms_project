# Server
PORT=4000
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hospital_db

# Auth
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=8h

# AI layer (optional — the rule-based risk score works with or without this;
# this only powers the natural-language "why" explanation text)
ANTHROPIC_API_KEY=
AI_EXPLANATION_ENABLED=false

# CORS
FRONTEND_ORIGIN=http://localhost:5173
